NATS_SERVERS=nats://100.109.131.12:4222,nats://100.109.131.12:4223,nats://100.109.131.12:4224
MACHINE_ID=plsystem

# PL system SiLA server endpoint.
SILA_HOST=127.0.0.1
SILA_PORT=50054

# Set SILA_DRY_RUN=true for local PUDA/NATS smoke tests without hardware.
SILA_DRY_RUN=false

# TLS is the SiLA default. For a local insecure SiLA server, set SILA_TLS=false
# or SILA_INSECURE=true.
SILA_TLS=true
SILA_INSECURE=false
SILA_ROOT_CERT_PATH=

# Safety limits. Leave XY limits empty until the lab confirms travel range.
LAC_MIN_PERCENT=0
LAC_MAX_PERCENT=100
STAGE_X_MIN_MM=
STAGE_X_MAX_MM=
STAGE_Y_MIN_MM=
STAGE_Y_MAX_MM=
STAGE_Z_MIN_VOLTAGE=0
STAGE_Z_MAX_VOLTAGE=150
DEFAULT_SHUTTER_TIMEOUT=5
