<?xml version="1.0" encoding="UTF-8"?>
<Feature xmlns="http://www.sila-standard.org"
  SiLA2Version="1.1"
  FeatureVersion="1.0"
  Originator="astar.edu.sg"
  Category="instrumentation"
  MaturityLevel="Draft"
  Locale="en-us">
  <Identifier>SpectrometerControl</Identifier>
  <DisplayName>Spectrometer Control</DisplayName>
  <Description>SiLA 2 feature for AvaSpec spectrometer. Exposes device info and single measurement with configurable integration time and averages, based on spectrometer.py.</Description>

  <!-- Command: Perform a single measurement (spectrometer_measure_once) -->
  <Command>
    <Identifier>SpectrometerMeasureOnce</Identifier>
    <DisplayName>Spectrometer Measure Once</DisplayName>
    <Description>Perform a single spectrometer measurement, save a spectrum plot, and return success status with the plot file path.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>IntegrationTimeMs</Identifier>
      <DisplayName>Integration Time Ms</DisplayName>
      <Description>Integration time in milliseconds.</Description>
      <DataType>
        <Basic>Real</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Averages</Identifier>
      <DisplayName>Averages</DisplayName>
      <Description>Number of averages for the measurement.</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Success</Identifier>
      <DisplayName>Success</DisplayName>
      <Description>True if measurement and plot generation completed successfully.</Description>
      <DataType>
        <Basic>Boolean</Basic>
      </DataType>
    </Response>
    <Response>
      <Identifier>PlotFilePath</Identifier>
      <DisplayName>Plot File Path</DisplayName>
      <Description>Absolute file path of the saved spectrum plot image. Empty if generation failed.</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
  </Command>

  <!-- Property: Spectrometer device info (spectrometer_device_info) -->
  <Property>
    <Identifier>SpectrometerDeviceInfo</Identifier>
    <DisplayName>Spectrometer Device Info</DisplayName>
    <Description>Connection status, description, serial number, and error if any.</Description>
    <Observable>No</Observable>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Connected</Identifier>
          <DisplayName>Connected</DisplayName>
          <Description>True if spectrometer is connected.</Description>
          <DataType>
            <Basic>Boolean</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Description</Identifier>
          <DisplayName>Description</DisplayName>
          <Description>Device description (e.g. AvaSpec spectrometer).</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>SerialNumber</Identifier>
          <DisplayName>Serial Number</DisplayName>
          <Description>Device serial number.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Error</Identifier>
          <DisplayName>Error</DisplayName>
          <Description>Error message if connection or init failed; empty if none.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </Property>
</Feature>
